{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leoflow.io/schemas/dag.json/v1.0",
  "title": "Leoflow DAG Specification",
  "description": "Canonical serialized representation of a DAG, consumed by the Leoflow Control Plane.",
  "type": "object",
  "required": [
    "schema_version",
    "dag_id",
    "dag_version",
    "image",
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Semver of this DAG specification format."
    },
    "dag_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_-]{0,199}$",
      "description": "User-facing DAG identifier. Unique within a tenant."
    },
    "dag_version": {
      "type": "string",
      "description": "Version of this DAG snapshot. Typically a Git tag or build identifier."
    },
    "image": {
      "type": "string",
      "description": "Fully qualified container image reference (e.g., 'myrepo/etl:v1.2.3')."
    },
    "description": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "schedule": {
      "type": [
        "string",
        "null"
      ],
      "description": "Cron expression, preset ('@daily', '@hourly'), or null for manual-only."
    },
    "schedule_timezone": {
      "type": "string",
      "default": "UTC"
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "max_active_runs": {
      "type": "integer",
      "minimum": 1,
      "default": 16
    },
    "catchup": {
      "type": "boolean",
      "default": false
    },
    "default_args": {
      "type": "object",
      "properties": {
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 0
        },
        "retry_delay_seconds": {
          "type": "integer",
          "minimum": 0,
          "default": 300
        },
        "execution_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "staging": {
      "type": "object",
      "description": "Opt-in per-DAG-run shared RWX volume mounted at /staging (ADR 0022).",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "size": { "type": "string", "description": "Kubernetes quantity, e.g. 5Gi." },
        "storage_class": { "type": "string", "description": "RWX StorageClass; empty = cluster default." }
      },
      "additionalProperties": false
    },
    "alerts": {
      "type": "object",
      "description": "Native on-failure alerting (#424), overlaid from leoflow.yaml; the scheduler fires it when the DagRun reaches failed.",
      "properties": {
        "on_failure": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["slack", "webhook"] },
              "conn": { "type": "string", "minLength": 1 },
              "message": { "type": "string" }
            },
            "required": ["type", "conn"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "source": {
      "type": "string",
      "description": "Original dag.py source, captured at compile time for the UI Code view."
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "task_id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_-]{0,199}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "python",
            "bash",
            "airflow_operator"
          ]
        },
        "operator_class": {
          "type": "string",
          "description": "For type=airflow_operator: the dotted Airflow operator/sensor class the runtime imports and executes (ADR 0040)."
        },
        "operator_args": {
          "type": "object",
          "description": "For type=airflow_operator: the operator's constructor kwargs captured at compile time."
        },
        "on_failure_callback": {
          "type": "boolean",
          "description": "Marks that the task declares an Airflow on_failure_callback (#424); the runtime runs it in the task process on failure. The callable itself is not carried."
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "trigger_rule": {
          "type": "string",
          "enum": [
            "all_success",
            "all_failed",
            "all_done",
            "one_success",
            "one_failed"
          ],
          "default": "all_success"
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "retry_delay_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "execution_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "execution_mode": {
          "type": "string",
          "enum": [
            "pod"
          ],
          "default": "pod",
          "description": "How a task runs. Every task (python, bash, airflow_operator) runs inside a worker pod via the agent; 'pod' is the only supported value and the default. Retained for forward compatibility."
        },
        "entrypoint": {
          "type": "string",
          "description": "For type=python: 'module.path:callable'. For type=bash: shell command."
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables for the worker pod / process."
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "source"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "enum": [
                  "env",
                  "vault",
                  "k8s_secret"
                ]
              },
              "reference": {
                "type": "string"
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "$ref": "#/$defs/resource_quantity"
            },
            "limits": {
              "$ref": "#/$defs/resource_quantity"
            }
          },
          "additionalProperties": false
        },
        "execution": {
          "type": "object",
          "description": "Executor-specific hints. Ignored if the chosen executor does not support them.",
          "properties": {
            "node_selector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "tolerations": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "service_account": {
              "type": "string"
            },
            "image_pull_policy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ],
              "default": "IfNotPresent"
            }
          }
        },
        "xcom_input": {
          "type": "object",
          "description": "Map of parameter name to ordered list of upstream task_ids whose return values to inject. A 1-element list is the common single-upstream case; longer lists are fan-in (the runtime delivers a JSON array, in declaration order).",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          }
        },
        "call_args": {
          "type": "object",
          "description": "TaskFlow literal call arguments captured at compile time (#115). Delivered to the runtime as LEOFLOW_CALL_ARGS_JSON. Each value must be JSON-serialisable; XCom upstreams take precedence at runtime over a same-name literal. Named call_args (not params) to leave Airflow's DAG-run params term free for a future feature.",
          "additionalProperties": true
        },
        "xcom_schema": {
          "type": "object",
          "description": "Optional JSON Schema for XCom output validation."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "python"
              }
            }
          },
          "then": {
            "required": [
              "entrypoint"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bash"
              }
            }
          },
          "then": {
            "required": [
              "entrypoint"
            ]
          }
        }
      ]
    },
    "resource_quantity": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "string",
          "description": "Kubernetes-style: '500m', '2', '1.5'."
        },
        "memory": {
          "type": "string",
          "description": "Kubernetes-style: '512Mi', '2Gi'."
        }
      },
      "additionalProperties": false
    }
  }
}
