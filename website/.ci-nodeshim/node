#!/usr/bin/env bash
# TEMP CI diagnostic shim — logs how `node` is invoked (and by what) so we can see
# where the `--permission` argument comes from, then delegates to the real node.
{
  echo "=== NODESHIM invoked ==="
  echo "argv: [$*]"
  echo "argc: $#"
  echo "NODE_OPTIONS=[${NODE_OPTIONS:-<unset>}]"
  echo "PPID cmdline: $(tr '\0' ' ' < /proc/$PPID/cmdline 2>/dev/null)"
} >&2
real="$(type -ap node | grep -v '/.ci-nodeshim/' | head -1)"
exec "$real" "$@"
